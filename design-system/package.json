{
  "name": "@allarise/design-system",
  "version": "0.1.0",
  "private": true,
  "description": "The Allarise info-site design system — tokens and components extracted from beta.allarise.app",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/allarise.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  },
  "allowScripts": {
    "esbuild@0.24.2": true
  }
}
